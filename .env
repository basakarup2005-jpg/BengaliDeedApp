import React, { useState } from 'react';
import { StyleSheet, Text, View, TextInput, Button, ScrollView } from 'react-native';
import { processDeedData } from './services/AiProcessor';

export default function App() {
  const [output, setOutput] = useState('Your generated deed will appear here...');

  return (
    <ScrollView style={styles.container}>
      <Text style={styles.header}>Bengali Deed AI 🖋️</Text>
      
      <View style={styles.section}>
        <Text>1. Paste E-Assessment Text (PDF):</Text>
        <TextInput style={styles.input} multiline placeholder="Paste PDF data here..." />
      </View>

      <View style={styles.section}>
        <Text>2. Boundaries (Chauhaddi):</Text>
        <TextInput style={styles.input} placeholder="N, S, E, W boundaries..." />
      </View>

      <Button title="Generate Tafsil & Body" onPress={() => setOutput("AI is thinking...")} />

      <View style={styles.resultBox}>
        <Text style={styles.resultText}>{output}</Text>
      </View>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 20, backgroundColor: '#fff' },
  header: { fontSize: 24, fontWeight: 'bold', marginTop: 40, marginBottom: 20 },
  section: { marginBottom: 15 },
  input: { borderWidth: 1, borderColor: '#ccc', padding: 10, borderRadius: 5, marginTop: 5 },
  resultBox: { marginTop: 20, padding: 15, backgroundColor: '#f0f0f0', borderRadius: 10 },
  resultText: { fontSize: 16, color: '#333' }
});
